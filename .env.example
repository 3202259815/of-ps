# 复制成 .env 后按需修改（docker compose 会自动读取）
# HTTP 端口：dispatch / 登录器 / 手机 SDK 都连这个
HTTP_PORT=25565
# 游戏数据端口：gate（客户端拿到 region_info 后连这个）
GATE_PORT=25566

# 下发给客户端的 gate 地址：
#   留空/0.0.0.0 = 自动用客户端访问 dispatch 时的 Host（推荐，直连公网 IP 或域名都行）
#   填具体值（如 1.2.3.4 或 os.example.com）= 强制下发该地址
PUBLIC_IP=0.0.0.0

# 资源版本：必须两段式，第二段与客户端 PackageManifest_*.version 一致
RES_VERSION=2026-10-21-14-05-50_2026-11-25-19-54-41
RES_URL=http://cdn-of.inutan.com/Resources;https://cdn-of.inutan.com/Resources

# 账号严格校验：true 时 gate 要求 sdk_uid/login_token 来自 /account/login
ACCOUNT_STRICT_TOKEN=false

# 基础镜像源：国内直连 docker.io 超时时改成镜像站
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
PYTHON_IMAGE=python:3.12-slim
